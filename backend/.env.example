# Application Settings
PROJECT_NAME="Academia–Industry Collaboration Portal"
SECRET_KEY="super-secret-jwt-key-for-academia-portal-2026!#$"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration:
# To use PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academia_portal
# By default, falls back to SQLite for local development:
DATABASE_URL=sqlite:///./portal.db

# Matching Engine Strategy:
# Options: "weighted_rules" (default, highly configurable with explainability) or "semantic_cosine"
MATCHING_ENGINE=weighted_rules
